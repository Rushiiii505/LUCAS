# Lucas Configuration Environment Variables

# Application
APP_NAME=Lucas
ENVIRONMENT=production
DEBUG=false

# Server & Network Binding
# 0.0.0.0 allows access across your local network (e.g. from phone, tablet, laptop)
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Optional LAN Authentication (Leave false for open LAN use)
LAN_AUTH_ENABLED=false
LAN_AUTH_TOKEN=your-secure-pre-shared-token-here

# Ollama Inference Engine
# Default local Ollama URL (use http://host.docker.internal:11434 if running backend in Docker)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Storage Directories
# Defaults to ./data relative to project root
DATA_DIR=data

# RAG & Retrieval Parameters
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.30
RAG_CONTEXT_BUDGET=3500
MAX_UPLOAD_SIZE_MB=25

# Raspberry Pi 5 Optimization
LOW_MEMORY_MODE=true
MAX_SIMULTANEOUS_GENERATIONS=1
MAX_SIMULTANEOUS_INGESTIONS=1
MAX_HISTORY_MESSAGES=12
REQUEST_TIMEOUT_SECONDS=120
